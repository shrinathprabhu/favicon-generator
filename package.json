{
  "name": "favicon-generator",
  "version": "1.0.0",
  "description": "A simple Sharp wrapper that generates favicon assets for your apps with a single SVG.",
  "homepage": "https://lowkey.tools/favigen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrinathprabhu/favicon-generator.git"
  },
  "bugs": {
    "url": "https://github.com/shrinathprabhu/favicon-generator/issues"
  },
  "type": "module",
  "bin": {
    "favicon-generator": "./bin/favicon-generator.js",
    "favicon-generator-gui": "./bin/favicon-generator-gui.js"
  },
  "scripts": {
    "check": "node --check ./bin/favicon-generator.js && node --check ./bin/favicon-generator-gui.js && node --check ./src/generator.js && node --check ./public/app.js",
    "cli": "node ./bin/favicon-generator.js",
    "gui": "node ./bin/favicon-generator-gui.js",
    "start": "node ./bin/favicon-generator.js"
  },
  "keywords": [
    "favicon",
    "svg",
    "icon",
    "apple-touch-icon",
    "manifest",
    "favicon-generator",
    "sharp",
    "favigen"
  ],
  "author": "Shrinath Prabhu <https://shrinath.me>",
  "license": "MIT",
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "sharp": "^0.35.4"
  }
}
