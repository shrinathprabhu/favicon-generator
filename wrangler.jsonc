{
  "name": "favigen",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "favigen.lowkey.tools", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
