{
  "name": "favigen",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "favigen.lowkey.tools", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
